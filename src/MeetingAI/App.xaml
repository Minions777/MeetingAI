<Application x:Class="MeetingAI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="PrimaryColor" Color="#7C3AED"/>
            <SolidColorBrush x:Key="BackgroundColor" Color="#1E1E2E"/>
            <SolidColorBrush x:Key="SurfaceColor" Color="#2D2D3D"/>
            <SolidColorBrush x:Key="TextColor" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="MutedColor" Color="#9CA3AF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>