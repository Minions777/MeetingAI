<Window x:Class="MeetingAI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="会议纪要助手 - MeetingAI" 
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">
  
    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6D28D9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4B5563"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4B5563"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3D"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#1F1F2E"/>
            <Setter Property="Foreground" Value="#7C3AED"/>
            <Setter Property="Height" Value="6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🎙️" FontSize="36" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="会议纪要助手" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="MeetingAI - 支持多 AI 模型" FontSize="12" Foreground="#9CA3AF"/>
            </StackPanel>
        </StackPanel>

        <!-- AI 配置区域 -->
        <Border Grid.Row="1" Background="#2D2D3D" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="AI 模型配置" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding ModelConfigs}" 
                              SelectedItem="{Binding SelectedConfig}"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="当前模型" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SelectedConfig.Model, Mode=OneWay}" IsReadOnly="True" Background="#1F1F2E"/>
                </StackPanel>

                <Button Grid.Column="2" Content="⚙️ 设置" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenSettingsCommand}" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- 录音控制区域 -->
        <Border Grid.Row="2" Background="#2D2D3D" CornerRadius="12" Padding="24" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Center">
                <!-- 音量指示器 -->
                <ProgressBar Value="{Binding VolumePercentage}" Maximum="100" Width="350" Margin="0,0,0,16"/>

                <!-- 时间显示 -->
                <TextBlock Text="{Binding RecordingTime}" FontSize="56" FontWeight="Light"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,16" FontFamily="Consolas"/>

                <!-- 控制按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="🔴 开始录音" Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartRecordingCommand}" Margin="0,0,12,0" MinWidth="140"/>
                    <Button Content="⏹️ 停止" Style="{StaticResource SecondaryButton}"
                            Command="{Binding StopRecordingCommand}" Margin="0,0,12,0"/>
                    <Button Content="📁 导入音频" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ImportAudioCommand}" Margin="0,0,12,0"/>
                    <Button Content="🔊 转录" Style="{StaticResource SecondaryButton}"
                            Command="{Binding TranscribeCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 转录内容区域 -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="📝 转录内容" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
        </Grid>

        <Border Grid.Row="4" Background="#2D2D3D" CornerRadius="12" Margin="0,0,0,8">
            <TextBox Text="{Binding Transcript, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent" Padding="16" MinHeight="120"/>
        </Border>

        <!-- 摘要区域 -->
        <Grid Grid.Row="5" Margin="0,0,0,8">
            <TextBlock Text="📋 AI 摘要" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
        </Grid>

        <Border Grid.Row="6" Background="#2D2D3D" CornerRadius="12" Margin="0,0,0,16">
            <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent" Padding="16" MinHeight="100"/>
        </Border>

        <!-- 底部操作栏 -->
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="🤖 生成摘要" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SummarizeCommand}" Margin="0,0,12,0"/>
                <Button Content="📋 一键复制" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CopySummaryCommand}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                <TextBlock Text=" | " Foreground="#4B5563" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="⚡ 处理中..." Foreground="#F59E0B" VerticalAlignment="Center"
                           Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>