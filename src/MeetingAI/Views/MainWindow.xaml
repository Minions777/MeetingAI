<Window x:Class="MeetingAI.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MeetingAI - 智能会议助手" Width="960" Height="640" Background="{DynamicResource BackgroundPrimary}" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🎙️ MeetingAI" FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="主题：" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding ThemeService.AvailableThemes}" SelectedItem="{Binding ThemeService.CurrentThemeName, Mode=TwoWay}" Style="{DynamicResource ComboBoxStyle}" Width="150"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="16">
                <ComboBox ItemsSource="{Binding AvailableConfigs}" SelectedItem="{Binding SelectedConfig}" DisplayMemberPath="Name" Width="220" Margin="0,0,16,0" Style="{DynamicResource ComboBoxStyle}"/>
                <Button Content="🎤 开始录音" Command="{Binding StartRecordingCommand}" Style="{DynamicResource PrimaryButton}" Width="120" Margin="0,0,16,0"/>
                <Button Content="⏹️ 停止录音" Command="{Binding StopRecordingCommand}" Style="{DynamicResource ButtonBase}" Width="120" Margin="0,0,16,0"/>
                <Button Content="📝 生成摘要" Command="{Binding GenerateSummaryCommand}" Style="{DynamicResource PrimaryButton}" Width="120"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                <DockPanel><TextBlock Text="📜 实时转录" DockPanel.Dock="Top" FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding TranscriptionText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/></ScrollViewer></DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                <DockPanel><TextBlock Text="🤖 AI 摘要" DockPanel.Dock="Top" FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/></ScrollViewer></DockPanel>
            </Border>
        </Grid>
        <StatusBar Grid.Row="3" Background="{DynamicResource BackgroundSecondary}" Foreground="{DynamicResource TextSecondary}" Padding="12,6"><TextBlock Text="{Binding StatusMessage}"/></StatusBar>
    </Grid>
</Window>