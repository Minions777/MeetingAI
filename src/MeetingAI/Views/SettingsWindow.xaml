<Window x:Class="MeetingAI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 模型设置" 
        Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style TargetType="Button" x:Key="SaveButton">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚙️ AI 模型设置" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="配置名称"/>
                <TextBox x:Name="NameTextBox" Text="{Binding Name, Mode=TwoWay}"/>

                <TextBlock Text="AI 提供商"/>
                <ComboBox x:Name="ProviderComboBox" SelectedIndex="0" SelectionChanged="ProviderComboBox_SelectionChanged">
                    <ComboBoxItem Content="OpenAI"/>
                    <ComboBoxItem Content="Anthropic Claude"/>
                    <ComboBoxItem Content="Google Gemini"/>
                    <ComboBoxItem Content="DeepSeek"/>
                    <ComboBoxItem Content="本地模型 (Ollama)"/>
                </ComboBox>

                <TextBlock Text="API Key"/>
                <TextBox x:Name="ApiKeyTextBox" Text="{Binding ApiKey, Mode=TwoWay}" TextChanged="ApiKeyTextBox_TextChanged"/>

                <TextBlock Text="API 地址"/>
                <TextBox x:Name="BaseUrlTextBox" Text="{Binding BaseUrl, Mode=TwoWay}"/>

                <TextBlock Text="模型名称"/>
                <TextBox x:Name="ModelTextBox" Text="{Binding Model, Mode=TwoWay}"/>

                <TextBlock Text="温度 (0.0-1.0)"/>
                <TextBox x:Name="TemperatureTextBox" Text="{Binding Temperature, Mode=TwoWay}"/>

                <TextBlock Text="最大 Token 数"/>
                <TextBox x:Name="MaxTokensTextBox" Text="{Binding MaxTokens, Mode=TwoWay}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="💾 保存" Style="{StaticResource SaveButton}" Click="SaveButton_Click"/>
            <Button Content="取消" Margin="12,0,0,0" Background="#374151" Foreground="White" Padding="20,12" BorderThickness="0" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>