<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <LinearGradientBrush x:Key="BackgroundPrimary" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0F172A" Offset="0"/><GradientStop Color="#1E293B" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#1A202C"/>
    <SolidColorBrush x:Key="BackgroundCard" Color="rgba(255,255,255,0.05)"/>
    <SolidColorBrush x:Key="BackgroundHover" Color="rgba(255,255,255,0.1)"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#CBD5E1"/>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#8B5CF6" Offset="0"/><GradientStop Color="#3B82F6" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="AccentBrushHover" Color="#7C3AED"/>
    <SolidColorBrush x:Key="BorderColor" Color="rgba(255,255,255,0.15)"/>
    <CornerRadius x:Key="ControlCornerRadius">12,12,12,12</CornerRadius>
    <Thickness x:Key="ControlPadding">14,10,14,10</Thickness>
    <FontFamily x:Key="FontFamilyPrimary">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
    <sys:Double x:Key="FontSizeBase">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">20</sys:Double>
</ResourceDictionary>