<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#121212"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BackgroundCard" Color="#252526"/>
    <SolidColorBrush x:Key="BackgroundHover" Color="#333333"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#00D4AA"/>
    <SolidColorBrush x:Key="AccentBrushHover" Color="#00B894"/>
    <SolidColorBrush x:Key="BorderColor" Color="#3A3A3A"/>
    <CornerRadius x:Key="ControlCornerRadius">8,8,8,8</CornerRadius>
    <Thickness x:Key="ControlPadding">12,8,12,8</Thickness>
    <FontFamily x:Key="FontFamilyPrimary">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
    <Double x:Key="FontSizeBase">13</Double>
    <Double x:Key="FontSizeLarge">18</Double>
</ResourceDictionary>