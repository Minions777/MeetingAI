<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BackgroundCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BackgroundHover" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#4B5563"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentBrushHover" Color="#2563EB"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>
    <CornerRadius x:Key="ControlCornerRadius">10,10,10,10</CornerRadius>
    <Thickness x:Key="ControlPadding">12,10,12,10</Thickness>
    <FontFamily x:Key="FontFamilyPrimary">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
    <sys:Double x:Key="FontSizeBase">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">18</sys:Double>
</ResourceDictionary>