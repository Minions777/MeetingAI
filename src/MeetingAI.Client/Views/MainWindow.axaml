<Window x:Class="MeetingAI.Client.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeetingAI.Client.Views"
        Title="MeetingAI - 智能会议助手"
        Height="800" Width="1200"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundSecondaryBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="48">

    <Border Background="{DynamicResource BackgroundBrush}"
            CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            BoxShadow="{DynamicResource ShadowLevel4}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BackgroundBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="16,8"
                    PointerPressed="TitleBar_PointerPressed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Icon and Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource BrainIcon}"
                              Fill="{DynamicResource PrimaryBrush}"
                              Width="24" Height="24" Stretch="Uniform"
                              Margin="0,0,12,0"/>
                        <TextBlock Text="MeetingAI"
                                   Classes="Headline"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" v2.0"
                                   Classes="Caption"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Provider Selector -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                        <Path Data="{StaticResource BrainIcon}"
                              Fill="{DynamicResource InfoBrush}"
                              Width="16" Height="16" Stretch="Uniform"
                              Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Providers.Providers}"
                                  SelectedItem="{Binding Providers.SelectedProvider}"
                                  MinWidth="180"
                                  HorizontalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Command="{Binding Providers.ReloadProvidersCommand}"
                                Classes="Icon"
                                ToolTip.Tip="刷新列表"
                                Margin="8,0,0,0">
                            <Path Data="{StaticResource RefreshIcon}"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Status Indicator -->
                        <Ellipse Width="10" Height="10"
                                 Fill="{Binding Recording.IsRecording, Converter={StaticResource RecordingStatusColorConverter}}"
                                 Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Classes="BodySmall"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>

                        <!-- Settings Button -->
                        <Button Command="{Binding OpenSettingsCommand}"
                                Classes="Icon"
                                ToolTip.Tip="设置">
                            <Path Data="{StaticResource SettingsIcon}"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="18" Height="18" Stretch="Uniform"/>
                        </Button>

                        <!-- Window Control Buttons -->
                        <Button x:Name="MinimizeButton"
                                Classes="Icon"
                                Click="MinimizeButton_Click"
                                Width="32" Height="32"
                                Margin="4,0,0,0">
                            <Path Data="M0,10 L10,10"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.5"
                                  Width="10" Height="1.5"/>
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Classes="Icon"
                                Click="MaximizeButton_Click"
                                Width="32" Height="32">
                            <Path Data="M0,0 L10,0 L10,10 L0,10 Z"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.5"
                                  Width="10" Height="10"/>
                        </Button>
                        <Button x:Name="CloseButton"
                                Classes="Icon"
                                Click="CloseButton_Click"
                                Width="32" Height="32">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.5"
                                  Width="10" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel - Recording & Transcript -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="24"
                        BoxShadow="{DynamicResource ShadowLevel2}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Recording Section Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <Path Data="{StaticResource MicIcon}"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Width="24" Height="24" Stretch="Uniform"
                                  Margin="0,0,12,0"/>
                            <TextBlock Text="录音"
                                       Classes="TitleSmall"/>
                        </StackPanel>

                        <!-- Duration and Volume -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource FillBrush}"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Padding="24"
                                Margin="0,0,0,20"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="4,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Recording.DurationText}"
                                           FontSize="56" FontWeight="Light"
                                           FontFamily="{DynamicResource PrimaryFont}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,16"/>

                                <!-- Volume Indicator -->
                                <ProgressBar Value="{Binding Recording.VolumeLevel}"
                                             Maximum="1"
                                             Height="8"
                                             VerticalAlignment="Center"/>

                                <!-- Recording Status -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,12,0,0"
                                            IsVisible="{Binding Recording.IsRecording}">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{DynamicResource ErrorBrush}"
                                             Margin="0,0,8,0"
                                             Classes.RecordingPulse="{Binding Recording.IsRecording}"/>
                                    <TextBlock Text="录音中..."
                                               Classes="Caption"
                                               Foreground="{DynamicResource ErrorBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Transcript Section -->
                        <Grid Grid.Row="2">
                            <Border Background="{DynamicResource FillBrush}"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Transcript Header -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                        <Path Data="{StaticResource DocTextIcon}"
                                              Fill="{DynamicResource TextTertiaryBrush}"
                                              Width="18" Height="18" Stretch="Uniform"
                                              Margin="0,0,10,0"/>
                                        <TextBlock Text="转录内容"
                                                   Classes="Body"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>

                                    <!-- Transcript Content -->
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding Summary.TranscriptText}"
                                                   Classes="Body"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="26"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Meeting History Section -->
                        <local:MeetingHistoryControl Grid.Row="3" Margin="0,20,0,0"/>
                    </Grid>
                </Border>

                <!-- Column Separator -->
                <Border Grid.Column="1"
                        Width="1"
                        Background="{DynamicResource BorderBrush}"
                        VerticalAlignment="Stretch"
                        Margin="7,0"/>

                <!-- Right Panel - Summary -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="24"
                        BoxShadow="{DynamicResource ShadowLevel2}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Summary Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <Path Data="{StaticResource BrainIcon}"
                                  Fill="{DynamicResource InfoBrush}"
                                  Width="24" Height="24" Stretch="Uniform"
                                  Margin="0,0,12,0"/>
                            <TextBlock Text="会议摘要"
                                       Classes="TitleSmall"/>
                        </StackPanel>

                        <!-- Summary Content -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <Panel>
                                <!-- Summary Text (shown when summary exists) -->
                                <Border Background="{DynamicResource FillBrush}"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        Padding="24"
                                        BorderBrush="{DynamicResource InfoBrush}"
                                        BorderThickness="4,0,0,0"
                                        IsVisible="{Binding Summary.HasSummary}">
                                    <TextBlock Text="{Binding Summary.SummaryText}"
                                               Classes="BodyLarge"
                                               TextWrapping="Wrap"
                                               LineHeight="28"/>
                                </Border>

                                <!-- Empty State (shown when no summary) -->
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MinHeight="200"
                                            IsVisible="{Binding Summary.HasSummary, Converter={StaticResource InverseBoolConverter}}">
                                    <Path Data="{StaticResource DocTextIcon}"
                                          Fill="{DynamicResource TextTertiaryBrush}"
                                          Width="64" Height="64" Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          Opacity="0.3"/>
                                    <TextBlock Text="暂无摘要"
                                               Classes="Headline"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,20,0,12"/>
                                    <TextBlock Text="录制并转录会议后，点击生成摘要"
                                               Classes="BodySmall"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               MaxWidth="280"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Panel>
                        </ScrollViewer>

                        <!-- Ask AI Panel -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource BackgroundGlassBrush}"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Padding="16"
                                Margin="0,16,0,0"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                IsVisible="{Binding Summary.ShowAIPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Ask AI Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource BrainIcon}"
                                              Fill="{DynamicResource InfoBrush}"
                                              Width="18" Height="18" Stretch="Uniform"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Text="AI 问答"
                                                   Classes="Body"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right"
                                            Classes="Icon"
                                            Width="24" Height="24"
                                            Command="{Binding Summary.CloseAIPanelCommand}">
                                        <Path Data="{StaticResource CloseIcon}"
                                              Fill="{DynamicResource TextTertiaryBrush}"
                                              Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                </Grid>

                                <!-- Selected Text -->
                                <Border Grid.Row="1"
                                        Background="{DynamicResource BackgroundTertiaryBrush}"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Summary.SelectedText}"
                                               Classes="Caption"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>

                                <!-- AI Response -->
                                <Border Grid.Row="2"
                                        Background="{DynamicResource BackgroundBrush}"
                                        CornerRadius="6"
                                        Padding="12">
                                    <StackPanel>
                                        <!-- Loading indicator -->
                                        <StackPanel Orientation="Horizontal"
                                                    IsVisible="{Binding Summary.IsAskingAI}"
                                                    Margin="0,0,0,8">
                                            <TextBlock Text="思考中..."
                                                       Classes="Caption"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Response text -->
                                        <TextBlock Text="{Binding Summary.AiResponseText}"
                                                   Classes="Body"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   IsVisible="{Binding Summary.IsAskingAI, Converter={StaticResource InverseBoolConverter}}"/>

                                        <!-- Error message -->
                                        <TextBlock Text="{Binding Summary.AiErrorMessage}"
                                                   Classes="Caption"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding Summary.AiErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Copy Button -->
                        <Button Grid.Row="3"
                                Command="{Binding CopySummaryCommand}"
                                Classes="Secondary"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0"
                                Padding="20,12">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CopyIcon}"
                                      Fill="{DynamicResource TextPrimaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Margin="0,0,10,0"/>
                                <TextBlock Text="复制摘要"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Control Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BackgroundBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="24,16"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Record/Stop Button -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Record Button (shown when not recording) -->
                        <Button Command="{Binding Recording.ToggleRecordingCommand}"
                                Classes="Record"
                                IsVisible="{Binding Recording.IsRecording, Converter={StaticResource InverseBoolConverter}}">
                            <Path Data="{StaticResource MicIcon}"
                                  Fill="White"
                                  Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Stop Button (shown when recording) -->
                        <Button Command="{Binding Recording.ToggleRecordingCommand}"
                                Classes="Stop"
                                IsVisible="{Binding Recording.IsRecording}">
                            <Path Data="{StaticResource StopIcon}"
                                  Fill="White"
                                  Width="32" Height="32" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- Center: Other Controls -->
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Pause/Resume Button -->
                        <Button Command="{Binding Recording.PauseResumeCommand}"
                                Classes="Secondary"
                                IsEnabled="{Binding Recording.IsRecording}"
                                Margin="0,0,16,0"
                                Padding="20,12">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource PauseIcon}"
                                      Fill="{DynamicResource TextPrimaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Margin="0,0,10,0"/>
                                <TextBlock Text="暂停"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Transcribe Button -->
                        <Button Command="{Binding TranscribeCommand}"
                                Classes="Secondary"
                                Padding="20,12"
                                Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource DocTextIcon}"
                                      Fill="{DynamicResource TextPrimaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Margin="0,0,10,0"/>
                                <TextBlock Text="转录"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Generate Summary Button -->
                        <Button Command="{Binding SummarizeCommand}"
                                Classes="Primary"
                                Padding="20,12">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource BrainIcon}"
                                      Fill="White"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Margin="0,0,10,0"/>
                                <TextBlock Text="生成摘要"
                                           Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Right: Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Recording.DurationText}"
                                   Classes="BodySmall"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
