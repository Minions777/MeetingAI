<UserControl x:Class="MeetingAI.Client.Views.MeetingHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MeetingAI.Client.Views"
             xmlns:i18n="clr-namespace:MeetingAI.Shared.i18n;assembly=MeetingAI.Shared"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="400">
    <Border Background="{StaticResource FillBrush}"
            CornerRadius="{StaticResource RadiusMedium}"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Path Data="{StaticResource HistoryIcon}"
                      Fill="{StaticResource TextTertiaryBrush}"
                      Width="18" Height="18" Stretch="Uniform"
                      Margin="0,0,10,0"/>
                <TextBlock Text="{i18n:Localize RecordingHistory}"
                           Style="{StaticResource BodyStyle}"
                           Foreground="{StaticResource TextTertiaryBrush}"/>
            </StackPanel>

            <!-- History List -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding MeetingHistory}"
                     SelectedItem="{Binding SelectedHistoryRecord}"
                     Style="{StaticResource ModernListBoxStyle}"
                     MaxHeight="160">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItemStyle}">
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Margin" Value="0,2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" 
                                           Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SavedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding DataContext.DeleteMeetingRecordCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource ModernIconButtonStyle}"
                                    Padding="4"
                                    ToolTip="删除">
                                <Path Data="{StaticResource TrashIcon}"
                                      Fill="{StaticResource ErrorBrush}"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty State -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding MeetingHistory.Count, Converter={StaticResource CountToVisibilityConverter}, FallbackValue=Visible}">
                <Path Data="{StaticResource HistoryIcon}"
                      Fill="{StaticResource TextTertiaryBrush}"
                      Width="32" Height="32" Stretch="Uniform"
                      HorizontalAlignment="Center"
                      Opacity="0.4"/>
                <TextBlock Text="{i18n:Localize NoRecordingHistory}"
                           Style="{StaticResource BodySmallStyle}"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>