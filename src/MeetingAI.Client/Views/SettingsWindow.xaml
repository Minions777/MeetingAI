<Window x:Class="MeetingAI.Client.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="设置" 
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Provider List -->
        <Border Grid.Column="0" Background="#2D2D30" CornerRadius="8" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="AI Providers" 
                           Foreground="White" FontSize="14" FontWeight="SemiBold"
                           Margin="16,16,16,12"/>
                
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Providers}"
                         SelectedItem="{Binding SelectedProvider}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="8,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Name}" Foreground="White"/>
                                <TextBlock Text="{Binding ProviderType}" 
                                           Foreground="#888888" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <Button Grid.Row="2" Content="➕ 添加" 
                        Command="{Binding AddProviderCommand}"
                        Style="{StaticResource ModernButtonStyle}"
                        Margin="16"/>
            </Grid>
        </Border>
        
        <!-- Provider Editor -->
        <Border Grid.Column="1" Background="#2D2D30" CornerRadius="8" Padding="20">
            <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="编辑 Provider" 
                           Foreground="White" FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,0,20"/>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="名称" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="Provider 类型" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableProviderTypes}"
                                  SelectedItem="{Binding EditProviderType}"
                                  Style="{StaticResource ModernComboBoxStyle}" 
                                  Margin="0,0,0,12"/>
                        
                        <TextBlock Text="API Key" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ApiKeyBox"
                                      Style="{StaticResource ModernPasswordBoxStyle}"
                                      Margin="0,0,0,12"/>
                        
                        <TextBlock Text="Base URL" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="模型" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditModel, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="Whisper 模型 (转录)" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditWhisperModel, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="Max Tokens" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditMaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="Temperature" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <Slider Value="{Binding EditTemperature}" 
                                 Minimum="0" Maximum="1" 
                                 TickFrequency="0.1"
                                 Style="{StaticResource ModernSliderStyle}"
                                 Margin="0,0,0,12"/>
                        
                        <CheckBox Content="启用" 
                                  IsChecked="{Binding EditIsEnabled}"
                                  Foreground="White"
                                  Margin="0,0,0,12"/>
                        
                        <Button Content="🧪 测试连接" 
                                Command="{Binding TestConnectionCommand}"
                                Style="{StaticResource ModernButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12"/>
                        
                        <TextBlock Text="{Binding StatusText}" Foreground="#4EC9B0"/>
                    </StackPanel>
                </ScrollViewer>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal" 
                            HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="💾 保存" 
                            Command="{Binding SaveProviderCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Width="100" Height="36"
                            Margin="0,0,10,0"/>
                    
                    <Button Content="❌ 取消" 
                            Command="{Binding CancelEditCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Width="100" Height="36"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
