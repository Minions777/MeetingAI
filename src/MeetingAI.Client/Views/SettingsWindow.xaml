<Window x:Class="MeetingAI.Client.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="设置 - MeetingAI" 
        Height="700" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundSecondaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BackgroundBrush}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Effect="{StaticResource ShadowLevel4}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="16,8"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- App Icon and Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource SettingsIcon}"
                              Fill="{StaticResource PrimaryBrush}"
                              Width="20" Height="20" Stretch="Uniform"
                              Margin="0,0,10,0"/>
                        <TextBlock Text="设置"
                                   Style="{StaticResource HeadlineStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="完成"
                                Command="{Binding SaveAndCloseCommand}"
                                Style="{StaticResource ModernPrimaryButtonStyle}"
                                Padding="20,8"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Provider List Sidebar -->
                <Border Grid.Column="0" 
                        Style="{StaticResource ModernCardStyle}"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Sidebar Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <Path Data="{StaticResource BrainIcon}"
                                  Fill="{StaticResource InfoBrush}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="AI Providers"
                                       Style="{StaticResource TitleSmallStyle}"/>
                        </StackPanel>
                        
                        <!-- Provider List -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Providers}"
                                 SelectedItem="{Binding SelectedProvider}"
                                 Style="{StaticResource ModernListBoxStyle}"
                                 SelectionChanged="ProviderList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItemStyle}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource BodyStyle}"/>
                                            <TextBlock Text="{Binding ProviderType}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ModernIconButtonStyle}"
                                                Padding="4"
                                                ToolTip="设为默认"
                                                Margin="0,0,8,0">
                                            <Path Data="{StaticResource StarIcon}"
                                                  Fill="{StaticResource TextTertiaryBrush}"
                                                  Width="16" Height="16" Stretch="Uniform"/>
                                        </Button>
                                        <Ellipse Grid.Column="2"
                                                 Width="10" Height="10"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <!-- Add Button -->
                        <Button Grid.Row="2"
                                Command="{Binding AddProviderCommand}"
                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                Margin="0,16,0,0"
                                Padding="0,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource PlusIcon}" 
                                      Fill="{StaticResource PrimaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Margin="0,0,10,0"/>
                                <TextBlock Text="添加 Provider"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- Provider Editor Panel -->
                <Border Grid.Column="2" 
                        Style="{StaticResource ModernCardStyle}"
                        Padding="24">
                    <Grid>
                        <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Editor Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                <TextBlock Text="编辑 Provider" 
                                           Style="{StaticResource TitleSmallStyle}"/>
                                <TextBlock Text="{Binding SelectedProvider.Name}" 
                                           Style="{StaticResource BodySmallStyle}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <!-- Editor Form -->
                            <ScrollViewer Grid.Row="1" 
                                          Style="{StaticResource ModernScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- 预设选择 -->
                                    <TextBlock Text="选择厂商" 
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AvailablePresets}"
                                              SelectedItem="{Binding SelectedPreset}"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              Margin="0,0,0,8"/>
                                    
                                    <!-- 预设描述 -->
                                    <TextBlock Text="{Binding SelectedPreset.Description}"
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="0,0,0,20"
                                               Visibility="{Binding SelectedPreset.Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    
                                    <!-- Name -->
                                    <TextBlock Text="配置名称" 
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Margin="0,0,0,20"/>
                                    
                                    <!-- API Key -->
                                    <TextBlock Text="API Key" 
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <PasswordBox x:Name="ApiKeyBox"
                                                  Style="{StaticResource ModernPasswordBoxStyle}"
                                                  Margin="0,0,0,8"
                                                  PasswordChanged="ApiKeyBox_PasswordChanged"/>
                                    <TextBlock Text="Ollama 本地部署无需填写 API Key"
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="0,0,0,20"/>
                                    
                                    <!-- Base URL -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Base URL" 
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <Button Grid.Column="1"
                                                Command="{Binding ToggleCustomUrlCommand}"
                                                Style="{StaticResource ModernIconButtonStyle}"
                                                Padding="4"
                                                ToolTip="自定义 URL"
                                                Margin="8,0,0,0">
                                            <Path Data="{StaticResource SettingsIcon}"
                                                  Width="14" Height="14" Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCustomUrl}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Button>
                                    </Grid>
                                    <TextBox Text="{Binding EditBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             IsReadOnly="{Binding IsCustomUrl, Converter={StaticResource InverseBoolConverter}}"
                                             Margin="0,0,0,20"/>
                                    
                                    <!-- 聊天模型 -->
                                    <TextBlock Text="聊天模型" 
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AvailableChatModels}"
                                              SelectedItem="{Binding EditModel}"
                                              IsEditable="True"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              Margin="0,0,0,20"/>
                                    
                                    <!-- Whisper 模型 -->
                                    <TextBlock Text="语音转录模型（Whisper）" 
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AvailableWhisperModels}"
                                              SelectedItem="{Binding EditWhisperModel}"
                                              IsEditable="True"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              Margin="0,0,0,20"/>
                                    
                                    <!-- 高级设置折叠 -->
                                    <Expander Header="高级设置" 
                                              Margin="0,0,0,16">
                                        <StackPanel Margin="0,12,0,0">
                                            <!-- Max Tokens -->
                                            <TextBlock Text="最大 Token 数" 
                                                       Style="{StaticResource CaptionStyle}"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding EditMaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     Margin="0,0,0,20"/>
                                            
                                            <!-- Temperature -->
                                            <TextBlock Text="Temperature" 
                                                       Style="{StaticResource CaptionStyle}"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,20">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0"
                                                        Value="{Binding EditTemperature}" 
                                                        Minimum="0" Maximum="2" 
                                                        TickFrequency="0.1"
                                                        Style="{StaticResource ModernSliderStyle}"/>
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding EditTemperature, StringFormat='{}{0:F1}'}"
                                                           Style="{StaticResource BodyStyle}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            
                                            <!-- Enabled -->
                                            <CheckBox Content="启用此配置"
                                                      IsChecked="{Binding EditIsEnabled}"
                                                      Style="{StaticResource ModernCheckBoxStyle}"
                                                      Margin="0,0,0,20"/>
                                        </StackPanel>
                                    </Expander>
                                    
                                    <!-- Test Connection -->
                                    <Button Command="{Binding TestConnectionCommand}"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Padding="20,12"
                                            Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource InfoIcon}" 
                                                  Fill="{StaticResource PrimaryBrush}"
                                                  Width="16" Height="16" Stretch="Uniform"
                                                  Margin="0,0,10,0"/>
                                            <TextBlock Text="测试连接"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <!-- Status Text -->
                                    <TextBlock Text="{Binding StatusText}"
                                               Style="{StaticResource BodySmallStyle}"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                            </ScrollViewer>
                            
                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="2" 
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Right" 
                                        Margin="0,24,0,0">
                                <Button Command="{Binding DeleteProviderCommand}"
                                        CommandParameter="{Binding SelectedProvider}"
                                        Style="{StaticResource ModernSecondaryButtonStyle}"
                                        Padding="20,12"
                                        Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource TrashIcon}"
                                              Fill="{StaticResource ErrorBrush}"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Margin="0,0,10,0"/>
                                        <TextBlock Text="删除"
                                                   Foreground="{StaticResource ErrorBrush}"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Command="{Binding SaveProviderCommand}"
                                        Style="{StaticResource ModernPrimaryButtonStyle}"
                                        Padding="24,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource CheckmarkIcon}" 
                                              Fill="White"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Margin="0,0,10,0"/>
                                        <TextBlock Text="保存"
                                                   Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Empty State -->
                        <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}">
                            <StackPanel HorizontalAlignment="Center" 
                                        VerticalAlignment="Center">
                                <Path Data="{StaticResource SettingsIcon}" 
                                      Fill="{StaticResource TextTertiaryBrush}"
                                      Width="72" Height="72" Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Opacity="0.3"/>
                                <TextBlock Text="选择一个 Provider 进行编辑" 
                                           Style="{StaticResource HeadlineStyle}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,24,0,12"/>
                                <TextBlock Text="或点击「添加 Provider」创建新的配置" 
                                           Style="{StaticResource BodySmallStyle}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>