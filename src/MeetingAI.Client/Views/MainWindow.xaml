<Window x:Class="MeetingAI.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MeetingAI.Client.Views"
        mc:Ignorable="d"
        Title="MeetingAI" 
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="8"
                      CornerRadius="0"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundPrimaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Traffic Lights -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" WindowChrome:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="CloseButton" Width="14" Height="14" Margin="6,0,0,0"
                        Background="#FF5F57" BorderThickness="0" Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="7"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="MinimizeButton" Width="14" Height="14" Margin="6,0,0,0"
                        Background="#FEBC2E" BorderThickness="0" Cursor="Hand"
                        Click="MinimizeButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="7"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="MaximizeButton" Width="14" Height="14" Margin="6,0,0,0"
                        Background="#28C840" BorderThickness="0" Cursor="Hand"
                        Click="MaximizeButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="7"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            
            <!-- Title -->
            <TextBlock Grid.Column="1" Text="MeetingAI"
                       Style="{StaticResource HeadlineStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            
            <!-- Settings Button -->
            <Button Grid.Column="2" 
                    Command="{Binding OpenSettingsCommand}"
                    Style="{StaticResource AppleIconButtonStyle}"
                    Margin="0,0,8,0"
                    ToolTip="Settings"
                    WindowChrome:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="{StaticResource SettingsIcon}" 
                      Fill="{StaticResource LabelSecondaryBrush}"
                      Width="20" Height="20" Stretch="Uniform"/>
            </Button>
        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Provider Selector Bar -->
            <Border Grid.Row="0" 
                    Background="{StaticResource BackgroundSecondaryBrush}" 
                    CornerRadius="16"
                    Padding="20,16"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Provider Label -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource BrainIcon}" 
                              Fill="{StaticResource SystemBlueBrush}"
                              Width="22" Height="22" Stretch="Uniform"
                              Margin="0,0,12,0"/>
                        <TextBlock Text="AI Provider" 
                                   Style="{StaticResource HeadlineStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Provider Dropdown -->
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding SelectedProvider}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource AppleComboBoxStyle}"
                              Margin="24,0"
                              MaxWidth="300"
                              HorizontalAlignment="Left"/>
                    
                    <!-- Status Indicator -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" 
                                 Fill="{Binding IsRecording, Converter={StaticResource RecordingStatusColorConverter}, FallbackValue={StaticResource SystemGreenBrush}}"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding StatusText}" 
                                   Style="{StaticResource SubheadStyle}"
                                   Foreground="{StaticResource LabelSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left Panel - Recording -->
                <Border Grid.Column="0" 
                        Background="{StaticResource BackgroundSecondaryBrush}" 
                        CornerRadius="20"
                        Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Recording Controls -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                            <!-- Duration Display -->
                            <TextBlock Text="{Binding DurationText}"
                                       FontSize="64" FontWeight="200"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource LabelPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,24"/>
                            
                            <!-- Waveform Visualizer (Volume) -->
                            <Grid Height="60" Width="400" Margin="0,0,0,32">
                                <ProgressBar Value="{Binding VolumeLevel}" 
                                              Maximum="1"
                                              Style="{StaticResource AppleProgressBarStyle}"
                                              Height="8"
                                              VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Control Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Record/Stop Button -->
                                <Button Command="{Binding ToggleRecordingCommand}"
                                        Style="{StaticResource AppleRecordButtonStyle}"
                                        Margin="0,0,32,0">
                                    <Button.Content>
                                        <Grid>
                                            <!-- Record Circle (idle) -->
                                            <Ellipse x:Name="recordIcon"
                                                     Fill="White"
                                                     Width="24" Height="24"
                                                     Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}"/>
                                            <!-- Stop Square (recording) -->
                                            <Border x:Name="stopIcon"
                                                    Background="White"
                                                    CornerRadius="4"
                                                    Width="22" Height="22"
                                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                
                                <!-- Pause/Resume Button -->
                                <Button Command="{Binding PauseResumeCommand}"
                                        Style="{StaticResource AppleSecondaryButtonStyle}"
                                        IsEnabled="{Binding IsRecording}"
                                        Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{Binding IsPaused, Converter={StaticResource PauseResumeIconConverter}, FallbackValue={StaticResource PauseIcon}}" 
                                              Fill="{StaticResource SystemBlueBrush}"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding IsPaused, Converter={StaticResource PauseResumeTextConverter}, FallbackValue='Pause'}"
                                                   Foreground="{StaticResource SystemBlueBrush}"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Transcribe Button -->
                                <Button Command="{Binding TranscribeCommand}"
                                        Style="{StaticResource AppleSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource DocTextIcon}" 
                                              Fill="{StaticResource LabelPrimaryBrush}"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Text="Transcribe"
                                                   Foreground="{StaticResource LabelPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Transcript Section -->
                        <Grid Grid.Row="1" Margin="0,32,0,0">
                            <Border Background="{StaticResource BackgroundTertiaryBrush}" 
                                    CornerRadius="16" 
                                    Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Transcript Header -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                        <Path Data="{StaticResource DocTextIcon}" 
                                              Fill="{StaticResource LabelTertiaryBrush}"
                                              Width="18" Height="18" Stretch="Uniform"
                                              Margin="0,0,10,0"/>
                                        <TextBlock Text="Transcript" 
                                                   Style="{StaticResource SubheadStyle}"
                                                   Foreground="{StaticResource LabelTertiaryBrush}"/>
                                    </StackPanel>
                                    
                                    <!-- Transcript Content -->
                                    <ScrollViewer Grid.Row="1" 
                                                  Style="{StaticResource AppleScrollViewerStyle}"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding TranscriptText}"
                                                   Style="{StaticResource BodyStyle}"
                                                   Foreground="{StaticResource LabelSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="26"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <!-- Generate Summary Button -->
                        <Button Grid.Row="2"
                                Command="{Binding SummarizeCommand}"
                                Style="{StaticResource ApplePrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,24,0,0"
                                Padding="0,16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource BrainIcon}" 
                                      Fill="White"
                                      Width="20" Height="20" Stretch="Uniform"
                                      Margin="0,0,10,0"/>
                                <TextBlock Text="Generate Summary" 
                                           FontSize="16" FontWeight="600"
                                           Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- Right Panel - Summary -->
                <Border Grid.Column="2" 
                        Background="{StaticResource BackgroundSecondaryBrush}" 
                        CornerRadius="20"
                        Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Summary Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <Path Data="{StaticResource BrainIcon}" 
                                  Fill="{StaticResource SystemPurpleBrush}"
                                  Width="24" Height="24" Stretch="Uniform"
                                  Margin="0,0,12,0"/>
                            <TextBlock Text="Meeting Summary" 
                                       Style="{StaticResource TitleSmallStyle}"/>
                        </StackPanel>
                        
                        <!-- Summary Content -->
                        <ScrollViewer Grid.Row="1" 
                                      Style="{StaticResource AppleScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Border Background="{StaticResource BackgroundTertiaryBrush}" 
                                        CornerRadius="16" 
                                        Padding="24">
                                    <TextBlock Text="{Binding SummaryText}"
                                               Style="{StaticResource BodyStyle}"
                                               TextWrapping="Wrap"
                                               LineHeight="28"/>
                                </Border>
                                
                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasSummary, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}">
                                    <Path Data="{StaticResource DocTextIcon}" 
                                          Fill="{StaticResource LabelTertiaryBrush}"
                                          Width="64" Height="64" Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          Opacity="0.5"/>
                                    <TextBlock Text="No summary yet" 
                                               Style="{StaticResource HeadlineStyle}"
                                               Foreground="{StaticResource LabelTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,16,0,8"/>
                                    <TextBlock Text="Record and transcribe a meeting, then click Generate Summary"
                                               Style="{StaticResource SubheadStyle}"
                                               Foreground="{StaticResource LabelTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                        
                        <!-- Copy Button -->
                        <Button Grid.Row="2"
                                Command="{Binding CopySummaryCommand}"
                                Style="{StaticResource AppleSecondaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0"
                                Padding="20,12">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CopyIcon}" 
                                      Fill="{StaticResource SystemBlueBrush}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Copy"
                                           Foreground="{StaticResource SystemBlueBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
