<Window x:Class="MeetingAI.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MeetingAI - 会议助手" 
        Height="700" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🎙️" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="MeetingAI" FontSize="20" FontWeight="Bold" 
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="1" Content="⚙️ 设置" 
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource ModernButtonStyle}"
                        Padding="16,8"/>
            </Grid>
        </Border>
        
        <!-- Provider Selector -->
        <Border Grid.Row="1" Background="#252526" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="AI Provider:" Foreground="#CCCCCC" 
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding SelectedProvider}"
                          DisplayMemberPath="Name"
                          Width="250"
                          Style="{StaticResource ModernComboBoxStyle}"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel - Recording -->
            <Border Grid.Column="0" Background="#2D2D30" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Recording Controls -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <!-- Duration Display -->
                        <TextBlock Text="{Binding DurationText}"
                                   FontSize="48" FontWeight="Light"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   FontFamily="Consolas"/>
                        
                        <!-- Volume Meter -->
                        <ProgressBar Value="{Binding VolumeLevel}" 
                                      Maximum="1" Height="8" 
                                      Margin="0,20,0,20"
                                      Width="300"
                                      Style="{StaticResource ModernProgressBarStyle}"/>
                        
                        <!-- Control Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="⏺ 开始录音" 
                                    Command="{Binding ToggleRecordingCommand}"
                                    Style="{StaticResource RecordButtonStyle}"
                                    Width="140" Height="50"
                                    Margin="0,0,10,0"/>
                            
                            <Button Content="{Binding IsPaused, Converter={StaticResource PauseResumeConverter}, FallbackValue='⏸️ 暂停'}" 
                                    Command="{Binding PauseResumeCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Width="100" Height="50"
                                    IsEnabled="{Binding IsRecording}"
                                    Margin="0,0,10,0"/>
                            
                            <Button Content="📝 转录" 
                                    Command="{Binding TranscribeCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Width="100" Height="50"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Transcript -->
                    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="4" 
                            Margin="0,20,0,0" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="📝 转录内容" 
                                       Foreground="#AAAAAA" FontSize="12"
                                       Margin="0,0,0,8"/>
                            
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding TranscriptText}"
                                           Foreground="#CCCCCC"
                                           TextWrapping="Wrap"
                                           FontSize="13"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            
            <!-- Right Panel - Summary -->
            <Border Grid.Column="2" Background="#2D2D30" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="📋 会议摘要" 
                               Foreground="#AAAAAA" FontSize="12"
                               Margin="0,0,0,12"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SummaryText}"
                                   Foreground="#CCCCCC"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   LineHeight="24"/>
                    </ScrollViewer>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" 
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="🤖 生成摘要" 
                                Command="{Binding SummarizeCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="120" Height="40"
                                Margin="0,0,10,0"/>
                        
                        <Button Content="📋 复制" 
                                Command="{Binding CopySummaryCommand}"
                                Style="{StaticResource ModernButtonStyle}"
                                Width="80" Height="40"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#007ACC" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" 
                           Foreground="White" FontSize="12"/>
                
                <TextBlock Grid.Column="1" Text="v2.0.0" 
                           Foreground="#ADD6FF" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
