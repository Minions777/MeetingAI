<Window x:Class="MeetingAI.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:MeetingAI.Client.Views"
        mc:Ignorable="d"
        Title="MeetingAI" 
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundSecondaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="8"
                      CornerRadius="0"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar (Windows 11 style) -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundPrimaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Drag Area -->
            <TextBlock Grid.Column="0" Text="MeetingAI"
                       Style="{StaticResource SubheadStyle}"
                       Foreground="{StaticResource LabelSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
            
            <!-- Window Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" 
                        Width="46" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MinimizeButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <Path Data="M4,12H20" Stroke="{StaticResource LabelSecondaryBrush}" StrokeThickness="1" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="MaximizeButton" 
                        Width="46" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MaximizeButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <Path Data="M4,4H16V16H4V4M6,8V14H14V8H6M8,2H18V18H2V8" Stroke="{StaticResource LabelSecondaryBrush}" StrokeThickness="1" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="CloseButton" 
                        Width="46" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}">
                                <Path Data="M6,6L18,18M6,18L18,6" Stroke="{StaticResource LabelSecondaryBrush}" StrokeThickness="1" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource SystemErrorBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Provider Selector Bar -->
            <Border Grid.Row="0" 
                    Background="{StaticResource BackgroundPrimaryBrush}" 
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Provider Label -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource BrainIcon}" 
                              Fill="{StaticResource SystemAccentBrush}"
                              Width="20" Height="20" Stretch="Uniform"
                              Margin="0,0,10,0"/>
                        <TextBlock Text="AI Provider" 
                                   Style="{StaticResource HeadlineStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Provider Dropdown -->
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding SelectedProvider}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource AppleComboBoxStyle}"
                              Margin="16,0"
                              MaxWidth="280"
                              HorizontalAlignment="Left"/>
                    
                    <!-- Status Indicator -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" 
                                 Fill="{Binding IsRecording, Converter={StaticResource RecordingStatusColorConverter}, FallbackValue={StaticResource SystemSuccessBrush}}"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding StatusText}" 
                                   Style="{StaticResource SubheadStyle}"
                                   Foreground="{StaticResource LabelSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left Panel - Recording -->
                <Border Grid.Column="0" 
                        Background="{StaticResource BackgroundPrimaryBrush}" 
                        CornerRadius="{StaticResource RadiusLarge}"
                        Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Recording Controls -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                            <!-- Duration Display -->
                            <TextBlock Text="{Binding DurationText}"
                                       FontSize="56" FontWeight="300"
                                       FontFamily="{StaticResource SegoeUIFont}"
                                       Foreground="{StaticResource LabelPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Volume Indicator -->
                            <Grid Height="6" Margin="0,0,0,24">
                                <ProgressBar Value="{Binding VolumeLevel}" 
                                             Maximum="1"
                                             Style="{StaticResource AppleProgressBarStyle}"
                                             Height="6"
                                             VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Control Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Record/Stop Button -->
                                <Button Command="{Binding ToggleRecordingCommand}"
                                        Style="{StaticResource AppleRecordButtonStyle}"
                                        Margin="0,0,24,0"/>
                                
                                <!-- Pause/Resume Button -->
                                <Button Command="{Binding PauseResumeCommand}"
                                        Style="{StaticResource AppleSecondaryButtonStyle}"
                                        IsEnabled="{Binding IsRecording}"
                                        Margin="0,0,12,0"
                                        Padding="16,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource PauseIcon}" 
                                              Fill="{StaticResource LabelPrimaryBrush}"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Text="Pause"
                                                   Foreground="{StaticResource LabelPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Transcribe Button -->
                                <Button Command="{Binding TranscribeCommand}"
                                        Style="{StaticResource AppleSecondaryButtonStyle}"
                                        Padding="16,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource DocTextIcon}" 
                                              Fill="{StaticResource LabelPrimaryBrush}"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Text="Transcribe"
                                                   Foreground="{StaticResource LabelPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Transcript Section -->
                        <Grid Grid.Row="1" Margin="0,24,0,0">
                            <Border Background="{StaticResource FillBrush}" 
                                    CornerRadius="{StaticResource RadiusMedium}" 
                                    Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Transcript Header -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                        <Path Data="{StaticResource DocTextIcon}" 
                                              Fill="{StaticResource LabelTertiaryBrush}"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Text="Transcript" 
                                                   Style="{StaticResource SubheadStyle}"
                                                   Foreground="{StaticResource LabelTertiaryBrush}"/>
                                    </StackPanel>
                                    
                                    <!-- Transcript Content -->
                                    <ScrollViewer Grid.Row="1" 
                                                  Style="{StaticResource AppleScrollViewerStyle}"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding TranscriptText}"
                                                   Style="{StaticResource BodyStyle}"
                                                   Foreground="{StaticResource LabelSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="24"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <!-- Generate Summary Button -->
                        <Button Grid.Row="2"
                                Command="{Binding SummarizeCommand}"
                                Style="{StaticResource ApplePrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,20,0,0"
                                Padding="0,14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource BrainIcon}" 
                                      Fill="White"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Generate Summary" 
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- Right Panel - Summary -->
                <Border Grid.Column="2" 
                        Background="{StaticResource BackgroundPrimaryBrush}" 
                        CornerRadius="{StaticResource RadiusLarge}"
                        Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Summary Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <Path Data="{StaticResource BrainIcon}" 
                                  Fill="{StaticResource SystemAccentBrush}"
                                  Width="22" Height="22" Stretch="Uniform"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="Meeting Summary" 
                                       Style="{StaticResource TitleSmallStyle}"/>
                        </StackPanel>
                        
                        <!-- Summary Content -->
                        <ScrollViewer Grid.Row="1" 
                                      Style="{StaticResource AppleScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Border Background="{StaticResource FillBrush}" 
                                        CornerRadius="{StaticResource RadiusMedium}" 
                                        Padding="20">
                                    <TextBlock Text="{Binding SummaryText}"
                                               Style="{StaticResource BodyStyle}"
                                               TextWrapping="Wrap"
                                               LineHeight="26"/>
                                </Border>
                                
                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasSummary, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}">
                                    <Path Data="{StaticResource DocTextIcon}" 
                                          Fill="{StaticResource LabelTertiaryBrush}"
                                          Width="56" Height="56" Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          Opacity="0.5"/>
                                    <TextBlock Text="No summary yet" 
                                               Style="{StaticResource HeadlineStyle}"
                                               Foreground="{StaticResource LabelTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,16,0,8"/>
                                    <TextBlock Text="Record and transcribe a meeting, then click Generate Summary"
                                               Style="{StaticResource SubheadStyle}"
                                               Foreground="{StaticResource LabelTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               MaxWidth="260"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                        
                        <!-- Copy Button -->
                        <Button Grid.Row="2"
                                Command="{Binding CopySummaryCommand}"
                                Style="{StaticResource AppleSecondaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CopyIcon}" 
                                      Fill="{StaticResource LabelPrimaryBrush}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Copy"
                                           Foreground="{StaticResource LabelPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
