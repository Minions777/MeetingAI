<UserControl x:Class="MeetingAI.Client.Views.MeetingHistoryControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MeetingAI.Client">
    <Border Background="{DynamicResource FillBrush}"
            CornerRadius="{StaticResource RadiusMedium}"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Path Data="{StaticResource HistoryIcon}"
                      Fill="{DynamicResource TextTertiaryBrush}"
                      Width="18" Height="18" Stretch="Uniform"
                      Margin="0,0,10,0"/>
                <TextBlock Text="录音历史"
                           Classes="Body"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>

            <!-- History List (visible when count > 0) -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding MeetingHistory}"
                     SelectedItem="{Binding SelectedHistoryRecord}"
                     MaxHeight="160"
                     IsVisible="{Binding MeetingHistory.Count, Converter={x:Static converters:GreaterThanZeroConverter.Instance}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="12,10">
                                <TextBlock Text="{Binding Title}"
                                           Classes="Body"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SavedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                           Classes="Caption"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding DataContext.DeleteMeetingRecordCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Classes="Icon"
                                    Padding="4"
                                    ToolTip.Tip="删除">
                                <Path Data="{StaticResource TrashIcon}"
                                      Fill="{DynamicResource ErrorBrush}"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty State (visible when count == 0) -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding MeetingHistory.Count, Converter={x:Static converters:CountToBoolConverter.Instance}}">
                <Path Data="{StaticResource HistoryIcon}"
                      Fill="{DynamicResource TextTertiaryBrush}"
                      Width="32" Height="32" Stretch="Uniform"
                      HorizontalAlignment="Center"
                      Opacity="0.3"/>
                <TextBlock Text="暂无录音记录"
                           Classes="BodySmall"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
