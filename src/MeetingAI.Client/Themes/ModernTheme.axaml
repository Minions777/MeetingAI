<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================
         MeetingAI Modern Design System v3.0
         Style selectors only — resources in App.axaml
         ============================================ -->

    <!-- ============================================
         Typography Styles
         ============================================ -->

    <Style Selector="TextBlock.TitleLarge">
        <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.TitleMedium">
        <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.TitleSmall">
        <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.Headline">
        <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.BodyLarge">
        <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.Body">
        <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.BodySmall">
        <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.Caption">
        <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>

    <!-- New: Label style for form labels -->
    <Style Selector="TextBlock.Label">
        <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- New: Mono style for code/technical content -->
    <Style Selector="TextBlock.Mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- ============================================
         Button Styles — Enhanced with micro-interactions
         ============================================ -->

    <Style Selector="Button.Primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Primary:pointerover">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>
    <Style Selector="Button.Primary:pressed">
        <Setter Property="Opacity" Value="0.8"/>
    </Style>
    <Style Selector="Button.Primary:disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <Style Selector="Button.Secondary">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource FillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
    </Style>
    <Style Selector="Button.Secondary:pressed">
        <Setter Property="Background" Value="{DynamicResource FillSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.Secondary:disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <Style Selector="Button.Icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource FillBrush}"/>
    </Style>
    <Style Selector="Button.Icon:pressed">
        <Setter Property="Background" Value="{DynamicResource FillSecondaryBrush}"/>
    </Style>

    <Style Selector="Button.Record">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource ErrorGradientBrush}"/>
        <Setter Property="CornerRadius" Value="40"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Record:pointerover">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>
    <Style Selector="Button.Record:pressed">
        <Setter Property="Opacity" Value="0.8"/>
    </Style>

    <Style Selector="Button.Stop">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource ErrorGradientBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Stop:pointerover">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>
    <Style Selector="Button.Stop:pressed">
        <Setter Property="Opacity" Value="0.8"/>
    </Style>

    <!-- RadioButton/Segment Style for chart type selector -->
    <Style Selector="RadioButton.Segment">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="RadioButton.Segment:pointerover">
        <Setter Property="Background" Value="{DynamicResource FillBrush}"/>
    </Style>
    <Style Selector="RadioButton.Segment:checked">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
    </Style>

    <!-- ============================================
         Input Styles
         ============================================ -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource FillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryLightBrush}"/>
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource FillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
    </Style>
    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
    </Style>

    <!-- ============================================
         ListBox Item Styles
         ============================================ -->

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource FillBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource PrimaryUltraLightBrush}"/>
    </Style>

    <!-- ============================================
         Expander Style
         ============================================ -->

    <Style Selector="Expander">
        <Setter Property="Background" Value="{DynamicResource FillBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ============================================
         Slider Style
         ============================================ -->

    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource FillTertiaryBrush}"/>
    </Style>

    <!-- ============================================
         ProgressBar Style
         ============================================ -->

    <Style Selector="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource FillTertiaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryGradientBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- ============================================
         CheckBox Style
         ============================================ -->

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- ============================================
         Animations
         ============================================ -->

    <!-- Recording pulse animation -->
    <Style Selector="Ellipse.RecordingPulse">
        <Style.Animations>
            <Animation Duration="0:0:1.5"
                       IterationCount="Infinite"
                       Easing="CubicEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.3"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

</Styles>
