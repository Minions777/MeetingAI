<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================
         Apple Design System Colors - Dark Mode
         ============================================ -->
    
    <!-- System Colors -->
    <Color x:Key="SystemBlueColor">#007AFF</Color>
    <Color x:Key="SystemGreenColor">#34C759</Color>
    <Color x:Key="SystemOrangeColor">#FF9500</Color>
    <Color x:Key="SystemRedColor">#FF3B30</Color>
    <Color x:Key="SystemPurpleColor">#5856D6</Color>
    <Color x:Key="SystemYellowColor">#FFCC00</Color>
    <Color x:Key="SystemTealColor">#5AC8FA</Color>
    <Color x:Key="SystemPinkColor">#FF2D55</Color>
    
    <!-- Background Colors (Apple Dark Mode) -->
    <Color x:Key="BackgroundPrimaryColor">#000000</Color>
    <Color x:Key="BackgroundSecondaryColor">#1C1C1E</Color>
    <Color x:Key="BackgroundTertiaryColor">#2C2C2E</Color>
    <Color x:Key="BackgroundElevatedColor">#3A3A3C</Color>
    
    <!-- Label Colors -->
    <Color x:Key="LabelPrimaryColor">#FFFFFF</Color>
    <Color x:Key="LabelSecondaryColor">#EBEBF5</Color>
    <Color x:Key="LabelTertiaryColor">#EBEBF5</Color>
    <Color x:Key="LabelQuaternaryColor">#EBEBF5</Color>
    
    <!-- Separator -->
    <Color x:Key="SeparatorColor">#38383A</Color>
    <Color x:Key="SeparatorOpaqueColor">#545458</Color>
    
    <!-- Fill Colors -->
    <Color x:Key="FillPrimaryColor">#787880</Color>
    <Color x:Key="FillSecondaryColor">#787880</Color>
    <Color x:Key="FillTertiaryColor">#767680</Color>
    <Color x:Key="FillQuaternaryColor">#787880</Color>
    
    <!-- Brushes - System -->
    <SolidColorBrush x:Key="SystemBlueBrush" Color="{StaticResource SystemBlueColor}"/>
    <SolidColorBrush x:Key="SystemGreenBrush" Color="{StaticResource SystemGreenColor}"/>
    <SolidColorBrush x:Key="SystemOrangeBrush" Color="{StaticResource SystemOrangeColor}"/>
    <SolidColorBrush x:Key="SystemRedBrush" Color="{StaticResource SystemRedColor}"/>
    <SolidColorBrush x:Key="SystemPurpleBrush" Color="{StaticResource SystemPurpleColor}"/>
    
    <!-- Brushes - Background -->
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimaryColor}"/>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondaryColor}"/>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="{StaticResource BackgroundTertiaryColor}"/>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="{StaticResource BackgroundElevatedColor}"/>
    
    <!-- Brushes - Label -->
    <SolidColorBrush x:Key="LabelPrimaryBrush" Color="{StaticResource LabelPrimaryColor}"/>
    <SolidColorBrush x:Key="LabelSecondaryBrush" Color="{StaticResource LabelSecondaryColor}"/>
    <SolidColorBrush x:Key="LabelTertiaryBrush" Color="{StaticResource LabelTertiaryColor}"/>
    
    <!-- Brushes - Separator -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}"/>
    
    <!-- Brushes - Fill -->
    <SolidColorBrush x:Key="FillPrimaryBrush" Color="{StaticResource FillPrimaryColor}"/>
    
    <!-- ============================================
         Apple Typography
         ============================================ -->
    
    <!-- Title - 34px Bold -->
    <FontFamily x:Key="AppleFont">Segoe UI</FontFamily>
    
    <Style x:Key="TitleLargeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFont}"/>
        <Setter Property="FontSize" Value="34</Setter>
        <Setter Property="FontWeight" Value="Bold</Setter>
        <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}"/>
    </Style>
    
    <!-- Title 2 - 28px Bold -->
    <Style x:Key="TitleMediumStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFont}"/>
        <Setter Property="FontSize" Value="28</Setter>
        <Setter Property="FontWeight" Value="Bold</Setter>
        <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}"/>
    </Style>
    
    <!-- Title 3 - 22px Semibold -->
    <Style x:Key="TitleSmallStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFont}"/>
        <Setter Property="FontSize" Value="22</Setter>
        <Setter Property="FontWeight" Value="SemiBold</Setter>
        <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}"/>
    </Style>
    
    <!-- Headline - 17px Semibold -->
    <Style x:Key="HeadlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFont}"/>
        <Setter Property="FontSize" Value="17</Setter>
        <Setter Property="FontWeight" Value="SemiBold</Setter>
        <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}"/>
    </Style>
    
    <!-- Body - 17px Regular -->
    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFont}"/>
        <Setter Property="FontSize" Value="17</Setter>
        <Setter Property="FontWeight" Value="Normal</Setter>
        <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}"/>
    </Style>
    
    <!-- Callout - 16px Regular -->
    <Style x:Key="CalloutStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFont}"/>
        <Setter Property="FontSize" Value="16</Setter>
        <Setter Property="FontWeight" Value="Normal</Setter>
        <Setter Property="Foreground" Value="{StaticResource LabelSecondaryBrush}"/>
    </Style>
    
    <!-- Subhead - 15px Regular -->
    <Style x:Key="SubheadStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFont}"/>
        <Setter Property="FontSize" Value="15</Setter>
        <Setter Property="FontWeight" Value="Normal</Setter>
        <Setter Property="Foreground" Value="{StaticResource LabelSecondaryBrush}"/>
    </Style>
    
    <!-- Footnote - 13px Regular -->
    <Style x:Key="FootnoteStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFont}"/>
        <Setter Property="FontSize" Value="13</Setter>
        <Setter Property="FontWeight" Value="Normal</Setter>
        <Setter Property="Foreground" Value="{StaticResource LabelTertiaryBrush}"/>
    </Style>
    
    <!-- Caption 1 - 12px Regular -->
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFont}"/>
        <Setter Property="FontSize" Value="12</Setter>
        <Setter Property="FontWeight" Value="Normal</Setter>
        <Setter Property="Foreground" Value="{StaticResource LabelTertiaryBrush}"/>
    </Style>
    
    <!-- Caption 2 - 11px Regular -->
    <Style x:Key="CaptionSmallStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFont}"/>
        <Setter Property="FontSize" Value="11</Setter>
        <Setter Property="FontWeight" Value="Normal</Setter>
        <Setter Property="Foreground" Value="{StaticResource LabelTertiaryBrush}"/>
    </Style>
    
    <!-- ============================================
         Apple Spacing System (8pt Grid)
         ============================================ -->
    <Thickness x:Key="SpacingXS">4</Thickness>
    <Thickness x:Key="SpacingSM">8</Thickness>
    <Thickness x:Key="SpacingMD">16</Thickness>
    <Thickness x:Key="SpacingLG">24</Thickness>
    <Thickness x:Key="SpacingXL">32</Thickness>
    <Thickness x:Key="SpacingXXL">48</Thickness>
    
    <!-- ============================================
         Corner Radius
         ============================================ -->
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">20</CornerRadius>
    
