<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================
         Windows 11 Fluent Design System - Light
         ============================================ -->

    <!-- System Colors -->
    <Color x:Key="SystemAccentColor">#0078D4</Color>
    <Color x:Key="SystemAccentLightColor">#4CC2FF</Color>
    <Color x:Key="SystemAccentDarkColor">#005A9E</Color>
    <Color x:Key="SystemSuccessColor">#107C10</Color>
    <Color x:Key="SystemWarningColor">#FF8C00</Color>
    <Color x:Key="SystemErrorColor">#D13438</Color>

    <!-- Background Colors (Windows 11 Mica-like) -->
    <Color x:Key="BackgroundPrimaryColor">#FFFFFF</Color>
    <Color x:Key="BackgroundSecondaryColor">#F3F3F3</Color>
    <Color x:Key="BackgroundTertiaryColor">#EBEBEB</Color>
    <Color x:Key="BackgroundElevatedColor">#FFFFFF</Color>
    <Color x:Key="BackgroundMicaColor">#F5F5F5</Color>

    <!-- Label Colors -->
    <Color x:Key="LabelPrimaryColor">#1A1A1A</Color>
    <Color x:Key="LabelSecondaryColor">#616161</Color>
    <Color x:Key="LabelTertiaryColor">#8A8A8A</Color>
    <Color x:Key="LabelDisabledColor">#ACACAC</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="BorderLightColor">#F0F0F0</Color>
    <Color x:Key="BorderFocusColor">#0078D4</Color>

    <!-- Fill Colors -->
    <Color x:Key="FillColor">#F5F5F5</Color>
    <Color x:Key="FillSecondaryColor">#E8E8E8</Color>
    <Color x:Key="FillTertiaryColor">#DBDBDB</Color>

    <!-- Brushes - System -->
    <SolidColorBrush x:Key="SystemAccentBrush" Color="{StaticResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentLightBrush" Color="{StaticResource SystemAccentLightColor}"/>
    <SolidColorBrush x:Key="SystemAccentDarkBrush" Color="{StaticResource SystemAccentDarkColor}"/>
    <SolidColorBrush x:Key="SystemSuccessBrush" Color="{StaticResource SystemSuccessColor}"/>
    <SolidColorBrush x:Key="SystemWarningBrush" Color="{StaticResource SystemWarningColor}"/>
    <SolidColorBrush x:Key="SystemErrorBrush" Color="{StaticResource SystemErrorColor}"/>

    <!-- Brushes - Background -->
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimaryColor}"/>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondaryColor}"/>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="{StaticResource BackgroundTertiaryColor}"/>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="{StaticResource BackgroundElevatedColor}"/>
    <SolidColorBrush x:Key="BackgroundMicaBrush" Color="{StaticResource BackgroundMicaColor}"/>

    <!-- Brushes - Label -->
    <SolidColorBrush x:Key="LabelPrimaryBrush" Color="{StaticResource LabelPrimaryColor}"/>
    <SolidColorBrush x:Key="LabelSecondaryBrush" Color="{StaticResource LabelSecondaryColor}"/>
    <SolidColorBrush x:Key="LabelTertiaryBrush" Color="{StaticResource LabelTertiaryColor}"/>
    <SolidColorBrush x:Key="LabelDisabledBrush" Color="{StaticResource LabelDisabledColor}"/>

    <!-- Brushes - Border -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>

    <!-- Brushes - Fill -->
    <SolidColorBrush x:Key="FillBrush" Color="{StaticResource FillColor}"/>
    <SolidColorBrush x:Key="FillSecondaryBrush" Color="{StaticResource FillSecondaryColor}"/>
    <SolidColorBrush x:Key="FillTertiaryBrush" Color="{StaticResource FillTertiaryColor}"/>

    <!-- ============================================
         Windows 11 Typography (Segoe UI Variable)
         ============================================ -->

    <FontFamily x:Key="SegoeUIFont">Segoe UI Variable, Segoe UI</FontFamily>

    <Style x:Key="TitleLargeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}"/>
    </Style>

    <Style x:Key="TitleMediumStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}"/>
    </Style>

    <Style x:Key="TitleSmallStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}"/>
    </Style>

    <Style x:Key="HeadlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}"/>
    </Style>

    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}"/>
    </Style>

    <Style x:Key="CalloutStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource LabelSecondaryBrush}"/>
    </Style>

    <Style x:Key="SubheadStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource LabelSecondaryBrush}"/>
    </Style>

    <Style x:Key="FootnoteStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource LabelTertiaryBrush}"/>
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource LabelTertiaryBrush}"/>
    </Style>

    <!-- ============================================
         Spacing System (4pt Grid)
         ============================================ -->
    <Thickness x:Key="SpacingXS">2</Thickness>
    <Thickness x:Key="SpacingSM">4</Thickness>
    <Thickness x:Key="SpacingMD">8</Thickness>
    <Thickness x:Key="SpacingLG">12</Thickness>
    <Thickness x:Key="SpacingXL">16</Thickness>
    <Thickness x:Key="SpacingXXL">24</Thickness>

    <!-- ============================================
         Windows 11 Corner Radius
         ============================================ -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>

