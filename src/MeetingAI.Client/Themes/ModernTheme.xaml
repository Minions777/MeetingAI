<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================
         MeetingAI Modern Design System v2.0
         ============================================ -->

    <!-- System Colors -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryLightColor">#3B82F6</Color>
    <Color x:Key="PrimaryDarkColor">#1D4ED8</Color>
    <Color x:Key="PrimaryUltraLightColor">#EFF6FF</Color>
    
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="InfoColor">#6366F1</Color>

    <!-- Background Colors -->
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="BackgroundSecondaryColor">#F8FAFC</Color>
    <Color x:Key="BackgroundTertiaryColor">#F1F5F9</Color>
    <Color x:Key="BackgroundQuaternaryColor">#E2E8F0</Color>
    <Color x:Key="BackgroundGlassColor">#FFFFFFCC</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextTertiaryColor">#94A3B8</Color>
    <Color x:Key="TextDisabledColor">#CBD5E1</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="BorderLightColor">#F1F5F9</Color>
    <Color x:Key="BorderFocusColor">#2563EB</Color>

    <!-- Fill Colors -->
    <Color x:Key="FillColor">#F8FAFC</Color>
    <Color x:Key="FillSecondaryColor">#F1F5F9</Color>
    <Color x:Key="FillTertiaryColor">#E2E8F0</Color>

    <!-- Brushes - Primary -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryUltraLightBrush" Color="{StaticResource PrimaryUltraLightColor}"/>

    <!-- Brushes - Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- Brushes - Background -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondaryColor}"/>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="{StaticResource BackgroundTertiaryColor}"/>
    <SolidColorBrush x:Key="BackgroundQuaternaryBrush" Color="{StaticResource BackgroundQuaternaryColor}"/>
    <SolidColorBrush x:Key="BackgroundGlassBrush" Color="{StaticResource BackgroundGlassColor}"/>

    <!-- Brushes - Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>

    <!-- Brushes - Border -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>

    <!-- Brushes - Fill -->
    <SolidColorBrush x:Key="FillBrush" Color="{StaticResource FillColor}"/>
    <SolidColorBrush x:Key="FillSecondaryBrush" Color="{StaticResource FillSecondaryColor}"/>
    <SolidColorBrush x:Key="FillTertiaryBrush" Color="{StaticResource FillTertiaryColor}"/>

    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#059669" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ErrorGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EF4444" Offset="0"/>
        <GradientStop Color="#DC2626" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================
         Typography
         ============================================ -->

    <FontFamily x:Key="PrimaryFont">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, Courier New</FontFamily>

    <Style x:Key="TitleLargeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="LineHeight" Value="1.2"/>
    </Style>

    <Style x:Key="TitleMediumStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="LineHeight" Value="1.3"/>
    </Style>

    <Style x:Key="TitleSmallStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="LineHeight" Value="1.4"/>
    </Style>

    <Style x:Key="HeadlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="LineHeight" Value="1.4"/>
    </Style>

    <Style x:Key="BodyLargeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="LineHeight" Value="1.5"/>
    </Style>

    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="LineHeight" Value="1.5"/>
    </Style>

    <Style x:Key="BodySmallStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="LineHeight" Value="1.5"/>
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="LineHeight" Value="1.4"/>
    </Style>

    <Style x:Key="OverlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
    </Style>

    <!-- ============================================
         Spacing System
         ============================================ -->

    <Thickness x:Key="SpacingXS">4</Thickness>
    <Thickness x:Key="SpacingSM">8</Thickness>
    <Thickness x:Key="SpacingMD">12</Thickness>
    <Thickness x:Key="SpacingLG">16</Thickness>
    <Thickness x:Key="SpacingXL">20</Thickness>
    <Thickness x:Key="Spacing2XL">24</Thickness>
    <Thickness x:Key="Spacing3XL">32</Thickness>
    <Thickness x:Key="Spacing4XL">40</Thickness>
    <Thickness x:Key="Spacing5XL">48</Thickness>

    <!-- ============================================
         Corner Radius
         ============================================ -->

    <CornerRadius x:Key="RadiusNone">0</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

    <!-- ============================================
         Shadow System
         ============================================ -->

    <DropShadowEffect x:Key="ShadowLevel1" 
                      BlurRadius="2" 
                      ShadowDepth="1" 
                      Direction="270" 
                      Opacity="0.05" 
                      Color="#000000"/>

    <DropShadowEffect x:Key="ShadowLevel2" 
                      BlurRadius="6" 
                      ShadowDepth="2" 
                      Direction="270" 
                      Opacity="0.1" 
                      Color="#000000"/>

    <DropShadowEffect x:Key="ShadowLevel3" 
                      BlurRadius="15" 
                      ShadowDepth="4" 
                      Direction="270" 
                      Opacity="0.1" 
                      Color="#000000"/>

    <DropShadowEffect x:Key="ShadowLevel4" 
                      BlurRadius="25" 
                      ShadowDepth="8" 
                      Direction="270" 
                      Opacity="0.1" 
                      Color="#000000"/>

    <DropShadowEffect x:Key="ShadowPrimary" 
                      BlurRadius="14" 
                      ShadowDepth="4" 
                      Direction="270" 
                      Opacity="0.25" 
                      Color="#2563EB"/>

    <!-- ============================================
         Animation Durations
         ============================================ -->

    <Duration x:Key="DurationFast">0:0:0.15</Duration>
    <Duration x:Key="DurationNormal">0:0:0.2</Duration>
    <Duration x:Key="DurationSlow">0:0:0.3</Duration>
    <Duration x:Key="DurationVerySlow">0:0:0.5</Duration>

