<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:client="clr-namespace:MeetingAI.Client"
             x:Class="MeetingAI.Client.App">

    <Application.Resources>
        <ResourceDictionary>

            <!-- ============================================
                 Theme Dictionaries (Light / Dark)
                 ============================================ -->
            <ResourceDictionary.ThemeDictionaries>

                <!-- Light Mode -->
                <ResourceDictionary x:Key="Light">
                    <!-- Primary -->
                    <Color x:Key="PrimaryColor">#1E3A5F</Color>
                    <Color x:Key="PrimaryLightColor">#2563EB</Color>
                    <Color x:Key="PrimaryDarkColor">#152E4A</Color>
                    <Color x:Key="PrimaryUltraLightColor">#EFF6FF</Color>

                    <!-- Status -->
                    <Color x:Key="AccentColor">#059669</Color>
                    <Color x:Key="SuccessColor">#059669</Color>
                    <Color x:Key="WarningColor">#F59E0B</Color>
                    <Color x:Key="ErrorColor">#EF4444</Color>
                    <Color x:Key="InfoColor">#6366F1</Color>

                    <!-- Background -->
                    <Color x:Key="BackgroundColor">#FFFFFF</Color>
                    <Color x:Key="BackgroundSecondaryColor">#F8FAFC</Color>
                    <Color x:Key="BackgroundTertiaryColor">#F1F5F9</Color>
                    <Color x:Key="BackgroundQuaternaryColor">#E2E8F0</Color>
                    <Color x:Key="BackgroundGlassColor">#FFFFFFCC</Color>

                    <!-- Text -->
                    <Color x:Key="TextPrimaryColor">#0F172A</Color>
                    <Color x:Key="TextSecondaryColor">#475569</Color>
                    <Color x:Key="TextTertiaryColor">#94A3B8</Color>
                    <Color x:Key="TextDisabledColor">#CBD5E1</Color>

                    <!-- Border -->
                    <Color x:Key="BorderColor">#E2E8F0</Color>
                    <Color x:Key="BorderLightColor">#F1F5F9</Color>
                    <Color x:Key="BorderFocusColor">#2563EB</Color>

                    <!-- Fill -->
                    <Color x:Key="FillColor">#F8FAFC</Color>
                    <Color x:Key="FillSecondaryColor">#F1F5F9</Color>
                    <Color x:Key="FillTertiaryColor">#E2E8F0</Color>

                    <!-- Shadows -->
                    <BoxShadows x:Key="ShadowLevel1">0 1 2 0 #0D000000</BoxShadows>
                    <BoxShadows x:Key="ShadowLevel2">0 2 6 0 #1A000000</BoxShadows>
                    <BoxShadows x:Key="ShadowLevel3">0 4 15 0 #1A000000</BoxShadows>
                    <BoxShadows x:Key="ShadowLevel4">0 8 25 0 #1A000000</BoxShadows>
                    <BoxShadows x:Key="ShadowPrimary">0 4 14 0 #402563EB</BoxShadows>
                    <BoxShadows x:Key="ShadowRecordGlow">0 4 20 0 #40EF4444</BoxShadows>
                    <BoxShadows x:Key="ShadowRecordGlowHover">0 6 28 0 #60EF4444</BoxShadows>

                    <!-- Gradients -->
                    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#1E3A5F" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#059669" Offset="0"/>
                        <GradientStop Color="#047857" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ErrorGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#EF4444" Offset="0"/>
                        <GradientStop Color="#DC2626" Offset="1"/>
                    </LinearGradientBrush>
                </ResourceDictionary>

                <!-- Dark Mode -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Primary -->
                    <Color x:Key="PrimaryColor">#3B82F6</Color>
                    <Color x:Key="PrimaryLightColor">#60A5FA</Color>
                    <Color x:Key="PrimaryDarkColor">#2563EB</Color>
                    <Color x:Key="PrimaryUltraLightColor">#1E293B</Color>

                    <!-- Status -->
                    <Color x:Key="AccentColor">#10B981</Color>
                    <Color x:Key="SuccessColor">#10B981</Color>
                    <Color x:Key="WarningColor">#FBBF24</Color>
                    <Color x:Key="ErrorColor">#F87171</Color>
                    <Color x:Key="InfoColor">#818CF8</Color>

                    <!-- Background -->
                    <Color x:Key="BackgroundColor">#0F172A</Color>
                    <Color x:Key="BackgroundSecondaryColor">#1E293B</Color>
                    <Color x:Key="BackgroundTertiaryColor">#1E293B</Color>
                    <Color x:Key="BackgroundQuaternaryColor">#334155</Color>
                    <Color x:Key="BackgroundGlassColor">#0F172ACC</Color>

                    <!-- Text -->
                    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
                    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
                    <Color x:Key="TextTertiaryColor">#64748B</Color>
                    <Color x:Key="TextDisabledColor">#475569</Color>

                    <!-- Border -->
                    <Color x:Key="BorderColor">#334155</Color>
                    <Color x:Key="BorderLightColor">#1E293B</Color>
                    <Color x:Key="BorderFocusColor">#3B82F6</Color>

                    <!-- Fill -->
                    <Color x:Key="FillColor">#1E293B</Color>
                    <Color x:Key="FillSecondaryColor">#1E293B</Color>
                    <Color x:Key="FillTertiaryColor">#334155</Color>

                    <!-- Shadows (lighter for dark backgrounds) -->
                    <BoxShadows x:Key="ShadowLevel1">0 1 2 0 #1AFFFFFF</BoxShadows>
                    <BoxShadows x:Key="ShadowLevel2">0 2 6 0 #1AFFFFFF</BoxShadows>
                    <BoxShadows x:Key="ShadowLevel3">0 4 15 0 #1AFFFFFF</BoxShadows>
                    <BoxShadows x:Key="ShadowLevel4">0 8 25 0 #1AFFFFFF</BoxShadows>
                    <BoxShadows x:Key="ShadowPrimary">0 4 14 0 #403B82F6</BoxShadows>
                    <BoxShadows x:Key="ShadowRecordGlow">0 4 20 0 #40F87171</BoxShadows>
                    <BoxShadows x:Key="ShadowRecordGlowHover">0 6 28 0 #60F87171</BoxShadows>

                    <!-- Gradients -->
                    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#3B82F6" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#10B981" Offset="0"/>
                        <GradientStop Color="#059669" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ErrorGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#F87171" Offset="0"/>
                        <GradientStop Color="#EF4444" Offset="1"/>
                    </LinearGradientBrush>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!-- ============================================
                 Brushes (resolved via ThemeDictionaries)
                 ============================================ -->

            <!-- Primary -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}"/>
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLightColor}"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{DynamicResource PrimaryDarkColor}"/>
            <SolidColorBrush x:Key="PrimaryUltraLightBrush" Color="{DynamicResource PrimaryUltraLightColor}"/>

            <!-- Status -->
            <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}"/>
            <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}"/>

            <!-- Background -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}"/>
            <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{DynamicResource BackgroundSecondaryColor}"/>
            <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="{DynamicResource BackgroundTertiaryColor}"/>
            <SolidColorBrush x:Key="BackgroundQuaternaryBrush" Color="{DynamicResource BackgroundQuaternaryColor}"/>
            <SolidColorBrush x:Key="BackgroundGlassBrush" Color="{DynamicResource BackgroundGlassColor}"/>

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource TextTertiaryColor}"/>
            <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource TextDisabledColor}"/>

            <!-- Border -->
            <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
            <SolidColorBrush x:Key="BorderLightBrush" Color="{DynamicResource BorderLightColor}"/>
            <SolidColorBrush x:Key="BorderFocusBrush" Color="{DynamicResource BorderFocusColor}"/>

            <!-- Fill -->
            <SolidColorBrush x:Key="FillBrush" Color="{DynamicResource FillColor}"/>
            <SolidColorBrush x:Key="FillSecondaryBrush" Color="{DynamicResource FillSecondaryColor}"/>
            <SolidColorBrush x:Key="FillTertiaryBrush" Color="{DynamicResource FillTertiaryColor}"/>

            <!-- ============================================
                 Font Families (cross-platform)
                 ============================================ -->
            <FontFamily x:Key="PrimaryFont">Segoe UI Variable, Segoe UI, Inter, San Francisco, Helvetica Neue, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, SF Mono, Menlo, Courier New</FontFamily>

            <!-- ============================================
                 Corner Radius
                 ============================================ -->
            <CornerRadius x:Key="RadiusNone">0</CornerRadius>
            <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
            <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
            <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
            <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

            <!-- ============================================
                 Icon Paths
                 ============================================ -->
            <PathGeometry x:Key="MicIcon">M12 2C13.1 2 14 2.9 14 4V12C14 13.1 13.1 14 12 14C10.9 14 10 13.1 10 12V4C10 2.9 10.9 2 12 2ZM17 12C17 14.76 14.76 17 12 17C9.24 17 7 14.76 7 12H5C5 15.53 7.61 18.43 11 18.93V22H13V18.93C16.39 18.43 19 15.53 19 12H17Z</PathGeometry>
            <PathGeometry x:Key="PauseIcon">M6 19H10V5H6V19ZM14 5V19H18V5H14Z</PathGeometry>
            <PathGeometry x:Key="PlayIcon">M8 5.14V19.14L19 12.14L8 5.14Z</PathGeometry>
            <PathGeometry x:Key="StopIcon">M6 6H18V18H6V6Z</PathGeometry>
            <PathGeometry x:Key="DocTextIcon">M14 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V8L14 2ZM13 9H15V13H18V15H13V9M11 9H9V15H11V12H13V15H11V9Z</PathGeometry>
            <PathGeometry x:Key="CopyIcon">M19 21H8V7H19V21ZM19 5H8C6.9 5 6 5.9 6 7V21C6 22.1 6.9 23 8 23H19C20.1 23 21 22.1 21 21V7C21 5.9 20.1 5 19 5ZM16 1H4C2.9 1 2 1.9 2 3V17H4V3H16V1Z</PathGeometry>
            <PathGeometry x:Key="SettingsIcon">M12 15.5C10.07 15.5 8.5 13.93 8.5 12C8.5 10.07 10.07 8.5 12 8.5C13.93 8.5 15.5 10.07 15.5 12C15.5 13.93 13.93 15.5 12 15.5ZM19.43 12.97C19.47 12.65 19.5 12.33 19.5 12C19.5 11.67 19.47 11.35 19.43 11.03L21.54 9.37C21.73 9.22 21.78 8.95 21.66 8.73L19.66 5.27C19.54 5.05 19.27 4.96 19.05 5.05L16.56 6.05C16.04 5.66 15.5 5.32 14.87 5.07L14.5 2.42C14.46 2.18 14.25 2 14 2H10C9.75 2 9.54 2.18 9.5 2.42L9.13 5.07C8.5 5.32 7.96 5.66 7.44 6.05L4.95 5.05C4.73 4.96 4.46 5.05 4.34 5.27L2.34 8.73C2.21 8.95 2.27 9.22 2.46 9.37L4.57 11.03C4.53 11.35 4.5 11.67 4.5 12C4.5 12.33 4.53 12.65 4.57 12.97L2.46 14.63C2.27 14.78 2.21 15.05 2.34 15.27L4.34 18.73C4.46 18.95 4.73 19.04 4.95 18.95L7.44 17.95C7.96 18.34 8.5 18.68 9.13 18.93L9.5 21.58C9.54 21.82 9.75 22 10 22H14C14.25 22 14.46 21.82 14.5 21.58L14.87 18.93C15.5 18.68 16.04 18.34 16.56 17.95L19.05 18.95C19.27 19.04 19.54 18.95 19.66 18.73L21.66 15.27C21.78 15.05 21.73 14.78 21.54 14.63L19.43 12.97Z</PathGeometry>
            <PathGeometry x:Key="CheckmarkIcon">M21 7L9 19L3.5 13.5L4.91 12.09L9 16.17L19.59 5.59L21 7Z</PathGeometry>
            <PathGeometry x:Key="BrainIcon">M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20ZM12 6C9.79 6 8 7.79 8 10C8 12.21 9.79 14 12 14C14.21 14 16 12.21 16 10C16 7.79 14.21 6 12 6ZM12 12C10.9 12 10 11.1 10 10C10 8.9 10.9 8 12 8C13.1 8 14 8.9 14 10C14 11.1 13.1 12 12 12Z</PathGeometry>
            <PathGeometry x:Key="PlusIcon">M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z</PathGeometry>
            <PathGeometry x:Key="TrashIcon">M19 4H15.5L14.5 3H9.5L8.5 4H5V6H19M6 19C6 20.1 6.9 21 8 21H16C17.1 21 18 20.1 18 19V7H6V19Z</PathGeometry>
            <PathGeometry x:Key="InfoIcon">M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM13 17H11V11H13V17ZM13 9H11V7H13V9Z</PathGeometry>
            <PathGeometry x:Key="StarIcon">M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.62L12 2L9.19 8.62L2 9.24L7.45 13.97L5.82 21L12 17.27Z</PathGeometry>
            <PathGeometry x:Key="RefreshIcon">M17.65 6.35C16.2 4.9 14.21 4 12 4C7.58 4 4 7.58 4 12C4 16.42 7.58 20 12 20C15.73 20 18.84 17.45 19.73 14H17.65C16.83 16.33 14.61 18 12 18C8.69 18 6 15.31 6 12C6 8.69 8.69 6 12 6C13.66 6 15.14 6.69 16.22 7.78L13 11H20V4L17.65 6.35Z</PathGeometry>
            <PathGeometry x:Key="HistoryIcon">M13 3C8.03 3 4 7.03 4 12H1L4.89 15.89L4.96 16.03L9 12H6C6 8.13 9.13 5 13 5C16.87 5 20 8.13 20 12C20 15.87 16.87 19 13 19C11.07 19 9.32 18.21 8.06 16.94L6.64 18.35C8.27 19.98 10.51 21 13 21C17.97 21 22 16.97 22 12C22 7.03 17.97 3 13 3ZM12 8V13L16.28 15.54L17 14.33L13.5 12.25V8H12Z</PathGeometry>
            <PathGeometry x:Key="CloseIcon">M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12L19 6.41Z</PathGeometry>
            <PathGeometry x:Key="SaveIcon">M17 3H5C3.89 3 3 3.89 3 5V19C3 20.1 3.89 21 5 21H19C20.1 21 21 20.1 21 19V7L17 3ZM19 19H5V5H16.17L19 7.83V19ZM12 12C10.34 12 9 13.34 9 15C9 16.66 10.34 18 12 18C13.66 18 15 16.66 15 15C15 13.34 13.66 12 12 12ZM6 6H15V10H6V6Z</PathGeometry>

            <!-- ============================================
                 Converters
                 ============================================ -->
            <client:InverseBoolConverter x:Key="InverseBoolConverter" />
            <client:RecordingStatusColorConverter x:Key="RecordingStatusColorConverter" />
            <client:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <client:CountToBoolConverter x:Key="CountToBoolConverter" />
            <client:NotNullConverter x:Key="NotNullConverter" />
            <client:BoolToBrushConverter x:Key="BoolToBrushConverter" />
            <client:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
            <client:EnumBooleanConverter x:Key="EnumBooleanConverter" />

        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Themes/ModernTheme.axaml"/>
    </Application.Styles>

</Application>
